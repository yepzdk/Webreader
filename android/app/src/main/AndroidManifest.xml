<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read-only, and the reason is the offline page: WebView reports a dead radio as
         ERROR_HOST_LOOKUP, which classifies as "can't find that site" rather than "you're
         offline". Asking the system whether there is a network at all is the same question
         the GTK host puts to GLib, and it is what keeps `OfflineFallback.classify` shared. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Cleartext is allowed, because the intent filter below offers this app for every http
         link on the device. Blocking it would mean accepting those links and then refusing to
         load them: the user picks WebReader for an http article and gets an error page — and
         WebView reports the block as ERROR_UNKNOWN, so it reads as "you're offline" on a
         device that is demonstrably online. An app shaped like a browser has to load what it
         agrees to handle. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebReader"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <!-- The launcher entry. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with", and eligibility as a default browser. BROWSABLE plus a bare
                 http/https scheme with no host is what puts the app in the chooser for every
                 web link; DEFAULT is what lets an explicit chooser pick it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>

            <!-- The share sheet: this is the Android spelling of the iOS share extension. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

    <!-- Not required for `openExternally`: launching an implicit intent is exempt from package
         visibility, and `startActivity` is all that method does. What this buys is a truthful
         answer from `queryIntentActivities` and `resolveActivity` if anything here ever asks
         one — nothing does today, and the app catches `ActivityNotFoundException` instead. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

</manifest>
