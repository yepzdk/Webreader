<?xml version="1.0" encoding="utf-8"?>
<!-- The same mark as the other hosts - a brass drop cap, its paragraph, and a page marker -
     drawn in the artwork's own 1024 units so the paths are copied from
     Design/AppIcon/AppIcon.svg without retracing them.

     An adaptive icon hands the launcher a 108dp canvas, shows 72dp of it and only promises
     the centre 66dp circle. The mark's far corner sits 476 units from centre, so 0.65 is the
     largest scale that keeps every filled pixel inside that circle. Nothing else moves: the
     artwork is centred on both axes.

     The background is the tile colour in values/colors.xml, so the two together are the same
     picture as the iOS icon at a launcher-safe size. Themed icons mask this drawable's alpha
     and ignore its colours, which is why the same file serves as `monochrome`. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="0.65"
        android:scaleY="0.65">

        <!-- The page marker, and the darker band where it folds. -->
        <path
            android:pathData="M718,238H896V436L807,350L718,436L718,238Z"
            android:fillColor="#D9DED8" />
        <path
            android:pathData="M718,241H896V285H718V241Z"
            android:fillColor="#BEC7BD" />

        <!-- The drop cap. -->
        <path
            android:pathData="M143.464,263.328H121V240H232.888V263.328H196.168L248.44,490.128H250.6L314.536,240H361.192L425.128,490.128H427.288L479.56,263.328H442.84V240H532.696V263.328H510.232L441.112,541.536H391.432L327.928,303.936H325.768L262.264,541.536H212.584L143.464,263.328Z"
            android:fillColor="#C89F65" />

        <!-- The lines beside it, then the paragraph, which reads brighter. -->
        <path
            android:pathData="M664.359,240.536H590.359C578.209,240.536 568.359,250.386 568.359,262.536C568.359,274.686 578.209,284.536 590.359,284.536H664.359C676.509,284.536 686.359,274.686 686.359,262.536C686.359,250.386 676.509,240.536 664.359,240.536Z"
